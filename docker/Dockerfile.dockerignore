#
# Dockerfile 专属白名单：业务源码/原生工程只在运行时挂载，密钥和本地状态不入上下文。
**
!docker/
docker/**
!docker/Dockerfile
!docker/Dockerfile.dockerignore
!docker/entrypoint.sh
!docker/develop.sh
!docker/start-metro.cjs
!docker/prepare-project.cjs
!docker/configure-debug-host.py
!docker/build-rust.sh

# Defense in depth if the whitelist is extended later.
**/.git
**/.git/**
**/node_modules
**/node_modules/**
**/.env*
**/*.lock
**/package-lock.json
**/*.key
**/*.pem
**/*.p12
**/*.p8
**/*.jks
**/*.keystore
**/adbkey*
**/.gradle/**
**/.cache/**
**/metro-cache/**
**/docs/**
**/test/**
**/tests/**
**/__tests__/**
src
src/**
android
android/**
